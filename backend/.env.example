# PhishShield backend configuration
APP_NAME=PhishShield API
# SQLite for dev; use postgresql+psycopg2://user:pass@host:5432/phishshield for prod
DATABASE_URL=sqlite:///./phishshield.db
SECRET_KEY=generate-a-long-random-string-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
CORS_ORIGINS=http://localhost:5173

# SMTP (leave blank to use built-in simulation mailer)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=training@phishshield.local

# Base URL used in simulation landing links
SIMULATION_BASE_URL=http://localhost:8000
# Comma-separated allowlist of domains permitted for simulation emails
ALLOWED_SIMULATION_DOMAINS=phishshield.local,localhost
SEED_ON_STARTUP=true
RATE_LIMIT_PER_MINUTE=120

# ---- PayUnit billing (premium subscriptions) ----
# Get credentials at https://payunit.net → merchant dashboard → API CREDENTIALS
PAYUNIT_ENABLED=false
PAYUNIT_BASE_URL=https://gateway.payunit.net
PAYUNIT_API_USER=
PAYUNIT_API_PASSWORD=
PAYUNIT_API_KEY=        # application token, e.g. test_xxx / live_xxx
PAYUNIT_MODE=test       # test | live
PAYUNIT_CURRENCY=XAF
PAYUNIT_COUNTRY=CM
PAYUNIT_PREMIUM_PRICE=25000
PAYUNIT_PREMIUM_DAYS=30
# Optional overrides (defaults derived automatically):
# PAYUNIT_RETURN_URL=http://localhost:5173/billing/return
# PAYUNIT_NOTIFY_URL=http://localhost:8000/api/billing/payunit/notify
